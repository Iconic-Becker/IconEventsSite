# Copy to .env for local development. Railway variables replace this in
# production; see README.md for what each one does.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# Postgres. Railway supplies DATABASE_URL on the service once you add the
# database and reference it (${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgres://postgres@localhost:5433/iconic_photos

# Long random string. Signs sessions, unlock cookies and local media URLs.
SESSION_SECRET=change-me-to-64-random-hex-characters

# "local" keeps media on disk under DATA_DIR (development only).
# "r2" is production.
STORAGE_DRIVER=local
DATA_DIR=./data

# Cloudflare R2 (STORAGE_DRIVER=r2). Paste the token values here; never in chat.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=iconic-photos

# First owner account, read once at boot if no account exists yet.
# Remove both after the first sign-in. Alternative: npm run setup-owner.
# OWNER_EMAIL=
# OWNER_PASSWORD=

# Optional tuning (defaults shown).
# WORKER=true
# WORKER_CONCURRENCY=2
# PART_SIZE_MB=16
# MAX_FILE_GB=20
# MAX_TRANSCODE_MINUTES=15
# ZIP_PART_GB=2
# TRASH_DAYS=30
# URL_WINDOW_SECONDS=3600
