# Enquiry form delivery. See src/lib/enquiry.js for setup.
# Copy to .env.local for development, and set the same values in the host's
# environment variables so the production build picks them up.

# Web3Forms:  https://api.web3forms.com/submit
# Formspree:  https://formspree.io/f/<your-form-id>
VITE_FORM_ENDPOINT=

# Web3Forms only. Leave blank for Formspree.
VITE_FORM_ACCESS_KEY=
