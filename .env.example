# Enquiry form delivery. Optional.
#
# The live values are the defaults in src/lib/enquiry.js: Web3Forms,
# delivering to contact@iconic.events. Set these only to point a build
# somewhere else, such as a staging inbox.
#
# Web3Forms:  https://api.web3forms.com/submit   (needs the access key below)
# Formspree:  https://formspree.io/f/<form-id>   (ignores the access key)
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
